        {
          "name": "11 · Generate Quiz ⭐",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.quizId) pm.collectionVariables.set('quizId', res.quizId);",
                  "pm.test('Quiz generated', () => pm.response.to.have.status(200));",
                  "pm.test('Has 10 questions', () => pm.expect(res.questions.length).to.eql(10));",
                  "console.log('quizId saved:', res.quizId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"JavaScript Promises and Async/Await\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quiz/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quiz",
                "generate"
              ]
            },
            "description": "Generate 10 MCQ questions (3 easy, 3 medium, 4 hard) on any topic using Gemini AI.\n\nAuto-saves quizId to collection variable for use in Submit Assessment.\n\nquestionIds are auto-generated as q1–q10."
          },
          "response": []
        },
