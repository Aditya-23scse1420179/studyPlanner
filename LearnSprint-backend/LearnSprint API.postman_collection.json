        {
          "name": "13 · Submit Assessment ⭐",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quizId\": \"{{quizId}}\",\n  \"answers\": [\n    { \"questionId\": \"q1\",  \"selectedAnswer\": \"Paste exact option text here\" },\n    { \"questionId\": \"q2\",  \"selectedAnswer\": \"Paste exact option text here\" },\n    { \"questionId\": \"q3\",  \"selectedAnswer\": \"Paste exact option text here\" },\n    { \"questionId\": \"q4\",  \"selectedAnswer\": \"Paste exact option text here\" },\n    { \"questionId\": \"q5\",  \"selectedAnswer\": \"Paste exact option text here\" },\n    { \"questionId\": \"q6\",  \"selectedAnswer\": \"Paste exact option text here\" },\n    { \"questionId\": \"q7\",  \"selectedAnswer\": \"Paste exact option text here\" },\n    { \"questionId\": \"q8\",  \"selectedAnswer\": \"Paste exact option text here\" },\n    { \"questionId\": \"q9\",  \"selectedAnswer\": \"Paste exact option text here\" },\n    { \"questionId\": \"q10\", \"selectedAnswer\": \"Paste exact option text here\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assessments/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "submit"
              ]
            },
            "description": "Submit answers for a quiz generated by /quiz/generate.\n\n⚠️ IMPORTANT:\n1. First run '11 · Generate Quiz' — quizId is auto-saved\n2. Copy the exact option text from the generate response\n3. selectedAnswer must match EXACTLY (case-sensitive)\n\nReturns: score out of 10, percentage, classification, and breakdown with correct answers + explanations."
          },
          "response": []
